with-compiler: ghc-9.14.1

packages: .
          ./liquid-finfield
          ./liquid-fixpoint
          ./liquid-parallel
          ./liquid-prelude
          ./liquid-vector
          ./liquidhaskell-boot
          ./tests
          ./tests/benchmarks/popl18/lib
          ./benchmark-timings
          ./scripts/plot-performance
          ./scripts/profiling-driver

source-repository-package
    type: git
    location: https://github.com/qnikst/ghc-timings-report
    tag: 45ef3498e35897712bde8e002ce18df6d55f8b15

constraints:
  -- helps users detecting when and old cabal-install could spoil the build.
  Cabal >= 3.16

allow-newer:
  ghc-timings:base
  ,active:base
  ,aeson:containers
  ,aeson:template-haskell
  ,aeson:time
  ,binary-orphans:base
  ,blaze-svg:base
  ,diagrams-core:base
  ,diagrams-core:containers
  ,diagrams-lib:base
  ,diagrams-lib:containers
  ,diagrams-postscript:base
  ,diagrams-svg:base
  ,diagrams-svg:containers
  ,directory:time
  ,dual-tree:base
  ,indexed-traversable:base
  ,indexed-traversable:containers
  ,indexed-traversable-instances:base
  ,lens-family:containers
  ,lens-family-core:containers
  ,monoid-extras:base
  ,semialign:base
  ,semialign:containers
  ,statestack:base
  ,svg-builder:base
  ,SVGFonts:containers
  ,text:base
  ,text-iso8601:time
  ,time-compat:time
  ,these:base
  ,uuid-types:template-haskell

-- We could be using program-options here, but it would turn on parallelism
-- when building tests, and this interferes with benchmarking.
--
-- program-options
--   ghc-options: -j
package liquid-fixpoint
  ghc-options: -j
package liquidhaskell
  ghc-options: -j
package liquidhaskell-boot
  ghc-options: -j
package liquid-prelude
  ghc-options: -j
package liquid-vector
  ghc-options: -j
package liquid-parallel
  ghc-options: -j

flags: +devel

constraints:
  -- GHC 9.14 compatibility
  aeson >= 2.2.3.0
